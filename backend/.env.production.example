# Copy this file to backend/.env on the VPS, then fill the secret values.
# Update this one URL when your public domain changes.
APP_PUBLIC_URL="https://lightskyblue-ferret-333236.hostingersite.com"

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
PORT=4000
NODE_ENV=production
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Optional overrides. Leave unset when the frontend and API use the same domain via Nginx.
# FRONTEND_URL="https://lightskyblue-ferret-333236.hostingersite.com"
# CORS_ORIGINS="https://lightskyblue-ferret-333236.hostingersite.com"
# BACKEND_PUBLIC_URL="https://lightskyblue-ferret-333236.hostingersite.com"

