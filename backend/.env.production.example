# Use these variables for the standalone Hostinger backend application.
# Update this one URL when your public domain changes.
APP_PUBLIC_URL="https://lightskyblue-ferret-333236.hostingersite.com"

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connection_limit=5&pool_timeout=20"
DB_CONNECTION_LIMIT=5
NODE_ENV=production
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Hostinger supplies PORT automatically. For local production testing only:
# PORT=4000

# Recommended durable upload storage. Keep the service role key server-only.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
# SUPABASE_MEDIA_BUCKET="directory-media"
# SUPABASE_PRIVATE_BUCKET="directory-private"

# Optional one-time admin creation. Remove the password after the first successful login.
# ADMIN_BOOTSTRAP_EMAIL="you@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-unique-strong-password"
# ADMIN_BOOTSTRAP_NAME="Directory Admin"

# Required for browser-origin checks. Keep these pointed at the frontend domain.
FRONTEND_URL="https://lightskyblue-ferret-333236.hostingersite.com"
CORS_ORIGINS="https://lightskyblue-ferret-333236.hostingersite.com"

# Optional SMTP and payment settings.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# SMTP_FROM="Directory <no-reply@example.com>"
# ADMIN_LEAD_EMAIL="admin@example.com"
# ADMIN_FEATURED_EMAIL="admin@example.com"
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_secret"
