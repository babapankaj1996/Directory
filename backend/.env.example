DATABASE_URL="postgresql://postgres:postgres@localhost:5433/luxury_directory?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Optional comma-separated allowed frontend origins for API CORS.
# CORS_ORIGINS="https://example.com,https://www.example.com"
ADMIN_JWT_SECRET="change-this-admin-token-secret"

# Razorpay is optional. Wallet manual top-up works without these keys.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Email verification and password reset delivery.
# Without SMTP_* values, the backend logs local verification/reset links in the console.
# Set MAIL_DELIVERY=log to force console-only mail while developing.
# MAIL_DELIVERY=log
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# SMTP_FROM="Directory <no-reply@example.com>"
# Optional comma-separated admin recipients for every quote request.
# If omitted, the backend falls back to ADMIN_EMAIL, then SMTP_USER.
# ADMIN_LEAD_EMAIL="admin@example.com"
# Optional comma-separated admin recipients for owner featured placement requests.
# If omitted, the backend falls back to ADMIN_EMAIL, then SMTP_USER.
# ADMIN_FEATURED_EMAIL="admin@example.com"
