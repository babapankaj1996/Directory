generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProfileLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
  SPAM
}

model User {
  id                          String                      @id @default(cuid())
  name                        String
  email                       String                      @unique
  passwordHash                String
  role                        String                      @default("USER")
  status                      String                      @default("ACTIVE")
  emailVerified               Boolean                     @default(false)
  emailVerifyToken            String?
  emailVerifyTokenExpiresAt   DateTime?
  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  profiles                    Profile[]                   @relation("ProfileOwner")
  reviews                     ProfileReview[]
  savedProfiles               ProfileSave[]
  leadsSent                   ProfileLead[]
  featuredPlacementRequests   FeaturedPlacementRequest[]  @relation("FeaturedPlacementRequester")
  featuredPlacementCampaigns  FeaturedPlacementCampaign[] @relation("FeaturedPlacementCampaignOwner")
  featuredPayments            FeaturedPayment[]           @relation("FeaturedPaymentOwner")
  wallet                      UserWallet?
  walletTransactions          WalletTransaction[]         @relation("WalletTransactionOwner")
  walletAdminTransactions     WalletTransaction[]         @relation("WalletTransactionAdmin")
}

model Country {
  code      String    @id
  name      String
  status    String    @default("ACTIVE")
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cities    City[]
  profiles  Profile[]
}

model City {
  id          String    @id @default(cuid())
  slug        String
  name        String
  countryCode String
  status      String    @default("ACTIVE")
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  country     Country   @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  profiles    Profile[]

  @@unique([countryCode, slug])
  @@index([countryCode])
}

model Category {
  slug           String    @id
  name           String
  description    String?
  iconName       String    @default("BadgeCheck")
  status         String    @default("ACTIVE")
  isAdult        Boolean   @default(false)
  adultLevel     String    @default("NONE")
  minimumAge     Int       @default(0)
  showOnHomepage Boolean   @default(true)
  indexable      Boolean   @default(true)
  seoTitle       String?
  seoDesc        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  profiles       Profile[]

  @@index([isAdult])
  @@index([status, isAdult])
}

model Profile {
  id                         String                        @id @default(cuid())
  name                       String
  slug                       String
  description                String
  shortDescription           String?
  ownerName                  String
  ownerEmail                 String?
  phone                      String?
  whatsapp                   String?
  website                    String?
  address                    String?
  countryId                  String
  cityId                     String
  categoryId                 String
  status                     ProfileStatus                 @default(PENDING)
  isFeatured                 Boolean                       @default(false)
  featuredUntil              DateTime?
  rejectionReason            String?
  adminNotes                 String?
  coverImage                 String?
  avatarImage                String?
  rating                     Float                         @default(0)
  reviewCount                Int                           @default(0)
  viewCount                  Int                           @default(0)
  services                   Json                          @default("[]")
  pricing                    Json                          @default("[]")
  businessHours              Json                          @default("[]")
  seoTitle                   String?
  seoDescription             String?
  ownerUserId                String?
  isAdult                    Boolean                       @default(false)
  ageRestricted              Boolean                       @default(false)
  adultLevel                 String                        @default("NONE")
  adultDisclaimerAcceptedAt  DateTime?
  verificationStatus         String                        @default("NOT_REQUIRED")
  verificationNotes          String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  ownerUser                  User?                         @relation("ProfileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  country                    Country                       @relation(fields: [countryId], references: [code], onDelete: Restrict)
  city                       City                          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category                   Category                      @relation(fields: [categoryId], references: [slug], onDelete: Restrict)
  gallery                    ProfileGallery[]
  statusHistory              ProfileStatusHistory[]
  reviews                    ProfileReview[]
  insightEvents              ProfileInsightEvent[]
  savedBy                    ProfileSave[]
  leads                      ProfileLead[]
  verificationDocuments      ProfileVerificationDocument[]
  featuredPlacementRequests  FeaturedPlacementRequest[]
  featuredPlacementCampaigns FeaturedPlacementCampaign[]
  featuredPayments           FeaturedPayment[]

  @@unique([countryId, cityId, categoryId, slug])
  @@index([countryId, cityId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([viewCount])
  @@index([ownerUserId])
  @@index([isAdult])
  @@index([verificationStatus])
}

model FeaturedPlacementRequest {
  id                String                      @id @default(cuid())
  profileId         String
  ownerUserId       String?
  requestedDays     Int
  requestedPage     String
  requestedPagePath String
  status            String                      @default("PENDING")
  adminNote         String?
  placementKey      String?
  placementLabel    String?
  priceAmount       Int?
  currency          String                      @default("INR")
  paymentStatus     String                      @default("UNPAID")
  paymentProvider   String?
  reviewedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  profile           Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ownerUser         User?                       @relation("FeaturedPlacementRequester", fields: [ownerUserId], references: [id], onDelete: SetNull)
  campaigns         FeaturedPlacementCampaign[]
  payment           FeaturedPayment?

  @@index([profileId])
  @@index([ownerUserId])
  @@index([status, createdAt])
}

model FeaturedPlacementCampaign {
  id              String                    @id @default(cuid())
  profileId       String
  ownerUserId     String?
  requestId       String?
  pageType        String
  pagePath        String
  slot            String                    @default("TOP")
  status          String                    @default("ACTIVE")
  startsAt        DateTime                  @default(now())
  endsAt          DateTime?
  approvedAt      DateTime?
  cancelledAt     DateTime?
  adminNote       String?
  source          String                    @default("REQUEST")
  placementKey    String?
  placementLabel  String?
  priceAmount     Int?
  currency        String                    @default("INR")
  paymentStatus   String                    @default("UNPAID")
  paymentProvider String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  profile         Profile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ownerUser       User?                     @relation("FeaturedPlacementCampaignOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  request         FeaturedPlacementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@index([ownerUserId])
  @@index([requestId])
  @@index([pagePath, status, startsAt, endsAt])
  @@index([pageType, status])
}

model FeaturedPlacementPrice {
  id           String   @id @default(cuid())
  scopeKey     String
  pageType     String
  countryId    String?
  citySlug     String?
  categoryId   String?
  durationDays Int
  priceAmount  Int
  currency     String   @default("INR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scopeKey, durationDays, currency])
  @@index([pageType, isActive])
  @@index([countryId, citySlug, categoryId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  heldBalance  Int                 @default(0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String     @id @default(cuid())
  walletId      String
  userId        String
  type          String
  amount        Int
  currency      String     @default("INR")
  status        String     @default("COMPLETED")
  reason        String?
  referenceType String?
  referenceId   String?
  adminUserId   String?
  metadata      Json       @default("{}")
  createdAt     DateTime   @default(now())
  wallet        UserWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User       @relation("WalletTransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  adminUser     User?      @relation("WalletTransactionAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model FeaturedPayment {
  id                  String                    @id @default(cuid())
  requestId           String?                   @unique
  profileId           String?
  ownerUserId         String?
  provider            String
  status              String                    @default("PENDING")
  amount              Int
  currency            String                    @default("INR")
  razorpayOrderId     String?                   @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  walletTransactionId String?
  metadata            Json                      @default("{}")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  request             FeaturedPlacementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  profile             Profile?                  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  ownerUser           User?                     @relation("FeaturedPaymentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([ownerUserId])
  @@index([provider, status])
}

model ProfileVerificationDocument {
  id           String   @id @default(cuid())
  profileId    String
  type         String
  fileUrl      String
  originalName String?
  status       String   @default("PENDING")
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([type])
  @@index([status])
}

model ProfileLead {
  id                String            @id @default(cuid())
  profileId         String
  userId            String?
  name              String
  email             String?
  phone             String
  whatsapp          String?
  serviceNeeded     String?
  budget            String?
  timeline          String?
  contactPreference String?
  preferredDate     DateTime?
  preferredTime     String?
  message           String?
  source            String            @default("PROFILE_QUOTE")
  sourcePath        String?
  leadScore         Int               @default(45)
  leadQuality       String            @default("WARM")
  status            ProfileLeadStatus @default(NEW)
  ownerNote         String?
  adminNote         String?
  responseAt        DateTime?
  convertedAt       DateTime?
  followUpAt        DateTime?
  ipHash            String?
  userAgentHash     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([profileId, status, createdAt])
  @@index([ipHash])
  @@index([leadQuality])
  @@index([leadScore])
  @@index([sourcePath])
  @@index([responseAt])
}

model ProfileReview {
  id             String   @id @default(cuid())
  profileId      String
  userId         String
  rating         Int
  title          String?
  comment        String
  status         String   @default("PENDING")
  moderationNote String?
  ipHash         String?
  userAgentHash  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([profileId, status])
  @@index([userId])
  @@index([status])
  @@index([ipHash])
}

model ProfileGallery {
  id        String   @id @default(cuid())
  profileId String
  imageUrl  String
  title     String?
  altText   String?
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([category])
  @@index([isActive])
}

model ProfileStatusHistory {
  id        String         @id @default(cuid())
  profileId String
  oldStatus ProfileStatus?
  newStatus ProfileStatus
  reason    String?
  adminNote String?
  createdAt DateTime       @default(now())
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([newStatus])
}

model ProfileInsightEvent {
  id            String   @id @default(cuid())
  profileId     String
  type          String
  referrer      String?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([type])
  @@index([createdAt])
  @@index([profileId, type, createdAt])
}

model ProfileSave {
  id        String   @id @default(cuid())
  profileId String
  userId    String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([profileId])
  @@index([userId])
  @@index([createdAt])
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  image     String?
  status    String   @default("PUBLISHED")
  seoTitle  String?
  seoDesc   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  canonical   String?
  noIndex     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
