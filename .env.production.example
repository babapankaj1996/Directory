# Copy this file to .env.local on the VPS before running `npm run build`.
# Update this one URL when your public domain changes.
NEXT_PUBLIC_APP_URL="https://lightskyblue-ferret-333236.hostingersite.com"
APP_PUBLIC_URL="https://lightskyblue-ferret-333236.hostingersite.com"

# Use this when Express runs on the same VPS and Next should proxy /api and /uploads.
BACKEND_API_URL="http://127.0.0.1:4000"
BACKEND_PORT=4000
# Migrations run during `npm run build`; leave runtime migrations disabled.
RUN_MIGRATIONS_ON_START=false

# Required when Hostinger runs the frontend and backend from the same Node app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connection_limit=5&pool_timeout=20"
DB_CONNECTION_LIMIT=5
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"

# Recommended for uploads that must survive Hostinger redeployments. The service
# role key is server-only: never prefix it with NEXT_PUBLIC_. Buckets are created on first upload.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
# SUPABASE_MEDIA_BUCKET="directory-media"
# SUPABASE_PRIVATE_BUCKET="directory-private"

# Optional one-time admin creation. Use a unique 14+ character password, deploy,
# sign in successfully, then remove ADMIN_BOOTSTRAP_PASSWORD from the host. The
# email and name may remain configured; bootstrap runs only while a password exists.
# An invalid bootstrap value is skipped without taking the public site offline.
# ADMIN_BOOTSTRAP_EMAIL="you@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-unique-strong-password"
# ADMIN_BOOTSTRAP_NAME="Directory Admin"

# Optional public override. Leave unset when users should call the same domain via /api.
# NEXT_PUBLIC_SITE_URL="https://lightskyblue-ferret-333236.hostingersite.com"
# NEXT_PUBLIC_API_URL="https://lightskyblue-ferret-333236.hostingersite.com"
# Do not add NEXT_PUBLIC_BACKEND_API_URL. It is unused and would expose an internal URL to browsers.

# One-time local-to-Supabase data transfer. Keep this out of Hostinger and run
# `npm run backend:data:migrate` only while DATABASE_URL points to an empty target.
# SOURCE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/director_local?schema=public"
