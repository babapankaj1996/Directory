{
  "name": "luxury-directory-fullstack-postgres-prisma",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run backend:install && npm run backend:generate && next build",
    "start": "node scripts/start-production.mjs",
    "start:frontend": "next start",
    "start:fullstack": "node scripts/start-production.mjs",
    "type-check": "next typegen && tsc --noEmit --incremental false",
    "lint": "eslint app components lib tests middleware.ts next.config.ts playwright.config.ts tailwind.config.ts",
    "test:smoke": "playwright test",
    "test:api": "node tests/backend-api-smoke.mjs",
    "test:security": "node tests/production-security-smoke.mjs",
    "test:browser:production": "node tests/production-auth-browser.mjs",
    "test:site-audit": "node tests/site-audit.mjs",
    "backend:install": "npm --prefix backend ci --include=dev",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:setup": "npm --prefix backend run prisma:generate && npm --prefix backend run prisma:migrate && npm --prefix backend run seed",
    "backend:generate": "npm --prefix backend run prisma:generate",
    "backend:migrate": "npm --prefix backend run prisma:migrate",
    "backend:migrate:deploy": "npm --prefix backend run prisma:migrate:deploy",
    "backend:data:migrate": "npm --prefix backend run data:migrate",
    "backend:seed": "npm --prefix backend run seed",
    "backend:locations:import": "npm --prefix backend run locations:import",
    "backend:studio": "npm --prefix backend run prisma:studio"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "15.5.23",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.23"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "sharp": "^0.35.3"
  }
}
